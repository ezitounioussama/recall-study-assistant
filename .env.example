# Recall — environment variables, with no real values.
#
# Two processes, two files:
#   api/.env          copy from api/.env.example  (the FastAPI backend)
#   web/.env.local    copy from web/.env.example  (the Next.js client)
# This file is the index of everything either of them reads.

# ---- api/.env -----------------------------------------------------------------
# Signs the session cookie. Required, at least 32 characters, never committed.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

DATABASE_URL=sqlite+aiosqlite:///./recall.sqlite3
WEB_ORIGIN=http://localhost:3100
COOKIE_SECURE=false

# Local models through Ollama. "hash" is a no-model embedder used by the tests.
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2:3b          # qwen3:8b for better answers, slower on CPU
RETRIEVAL_MIN_SCORE=0.6
RETRIEVAL_K=5

# ---- web/.env.local -----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8100
