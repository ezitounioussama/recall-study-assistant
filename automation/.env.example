# Copy to automation/.env. Nothing here is committed.

# The account the automation studies for. The demo account is fine locally.
RECALL_EMAIL=demo@recall.study
RECALL_PASSWORD=

# Where the API is, as seen from inside the n8n container.
RECALL_API_URL=http://host.docker.internal:8100

# Fixed so the stored SMTP credential survives a restart.
N8N_ENCRYPTION_KEY=local-dev-key-not-a-secret
TZ=Africa/Casablanca
