# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-at-least-32-characters-of-randomness
DATABASE_URL=sqlite+aiosqlite:///./recall.sqlite3
WEB_ORIGIN=http://localhost:3100
# true in production. A session cookie over plain http is a session cookie
# anyone on the network has.
COOKIE_SECURE=false

# Embeddings. "ollama" (default) needs a local Ollama with the model pulled:
#   ollama pull nomic-embed-text
# "hash" is a no-model stand-in used by the tests; do not ship it.
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text

# Chat. Needs the model pulled: ollama pull llama3.2:3b (or qwen3:8b for quality).
CHAT_MODEL=llama3.2:3b

# The provider's key, when it needs one. A local Ollama does not, so this stays
# empty; an OpenAI-compatible gateway or a hosted endpoint does, and the adapter
# then sends it as `Authorization: Bearer`. Put the real value in .env, which is
# gitignored — never in code, and never in this file.
LLM_API_KEY=

# Seconds to wait for a model before giving up with a friendly error.
LLM_TIMEOUT_SECONDS=300
RETRIEVAL_MIN_SCORE=0.6
RETRIEVAL_K=5
